keys/
# Runtime media is local/deployment storage. Keep only the public fallback
# seal needed for a fresh deployment; uploaded PDFs, QR images, and LSB-sealed
# outputs remain ignored.
media/*
!media/seals/
media/seals/*
!media/seals/default_seal.png
db.sqlite3
.env
*.pem
.local-dev/
data/
staticfiles/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Generated test, report, and Python cache files
tmp/
output/reports/
__pycache__/
*.py[cod]

# Local tool output and logs
tools/
*.log
performance/fixtures/*.pdf
performance/fixtures/manifest.json
