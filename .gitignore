keys/
# Runtime media is local/deployment storage. Keep only the public fallback
# seal needed for a fresh deployment; uploaded PDFs, QR images, and LSB-sealed
# outputs remain ignored.
media/*
!media/seals/
media/seals/*
!media/seals/default_seal.png
db.sqlite3
.env
*.pem
.local-dev/
data/
staticfiles/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Generated test, report, and Python cache files
tmp/
output/reports/
__pycache__/
*.py[cod]

# Local tool output and logs
tools/
*.log
performance/fixtures/*.pdf
performance/fixtures/manifest.json

# Capstone paperwork, defense material and evidence runs (not part of the system)
Manuscript/
Presentation Needs/
pdfs/
output/*
!output/SealGuard_Alpha_Test_Reports/
!output/SealGuard_Alpha_Test_Evidence/
!output/pdf/

# One-off evidence and demo-document generators
scripts/adviser_evidence.py
scripts/adviser_regression.py
scripts/compile_adviser_evidence.py
scripts/export_evidence_audit_logs.py
scripts/finalize_adviser_evidence.py
scripts/demo_contracts/
scripts/seed_demo_uploads.py
scripts/organize_demo_folders.py
