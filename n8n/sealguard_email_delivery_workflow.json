      "position": [520, -80]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ok: true, channel: 'email', provider_message_id: $json.id || ''}) }}"
      },
      "id": "a1f0b6d5-ec70-40d4-8b27-9e4c31220104",
      "name": "Email Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
