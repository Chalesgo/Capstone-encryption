      "typeVersion": 2.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "fromEmail": "REPLACE_WITH_APPROVED_SENDER_EMAIL",
        "toEmail": "={{ $json.body.recipient }}",
        "subject": "={{ $json.body.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.body.body }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "8f4a2c63-6d18-4f3f-b4bb-3c9d5a210103",
      "name": "Send SealGuard Email",
