      "position": [760, -80]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 400,
        "responseBody": "={\"ok\":false,\"error\":\"This endpoint accepts email delivery only.\"}"
      },
      "id": "f6d1c2e3-b4a5-4678-9c01-2d3e4f510105",
      "name": "Reject Non Email",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [520, 100]
    }
