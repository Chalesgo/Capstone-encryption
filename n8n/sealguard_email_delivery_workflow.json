          "conditions": [
            {
              "leftValue": "={{ $json.body.channel }}",
              "rightValue": "email",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "db8b90a6-f3b9-4cb1-a5f0-8e3d2a719102",
